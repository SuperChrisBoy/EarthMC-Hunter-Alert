{
  "schemaVersion": 1,
  "id": "hunteralert",
  "version": "${version}",
  "name": "EarthMC Hunter Alert",
  "description": "Standalone EarthMC public map exposure, hunter alerts and affiliation intelligence; optional EMC Map Addon cache sharing.",
  "environment": "client",
  "license": "Apache-2.0",
  "entrypoints": {
    "client": [
      "net.earthmc.hunteralert.platform.HunterAlertClient"
    ],
    "modmenu": [
      "net.earthmc.hunteralert.platform.ModMenuIntegration"
    ]
  },
  "mixins": [
    "hunteralert.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.3",
    "fabric-api": "*",
    "minecraft": "1.21.11",
    "java": ">=21"
  },
  "suggests": {
    "townymapaddon": "1.4.5",
    "xaerominimap": "*",
    "modmenu": "*"
  }
}
